{
  // Cloudflare Workers med statiska filer. Bygget (`npm run build`) skriver till dist/,
  // och `npx wrangler deploy` publicerar den mappen. Utan den här filen försöker
  // Wrangler auto-konfigurera projektet och kräver då Vite 6 eller nyare.
  // "name" måste vara samma som Worker-namnet i Cloudflare.
  "name": "goal-tracker",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
